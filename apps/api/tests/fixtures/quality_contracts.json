            "200": {
              "content": {
                "application/json": {
                  "schema": {}
                }
              },
              "description": "Successful Response"
            }
          },
          "summary": "Broadcast Database Cleared",
          "tags": [
            "Streaming"
          ]
        }
      },
      "/api/v1/stream/earthquakes": {
        "get": {
          "description": "Kênh SSE (Server-Sent Events) phát luồng dữ liệu địa chấn thời gian thực.\nĐẩy thông báo khi:\n1. Hoàn tất chu kỳ cào USGS 5 phút (ingestion_cycle_completed).\n2. Phát hiện có động đất mới nạp vào CSDL (earthquake_detected).\n3. CSDL bị xóa trống (database_cleared).\n4. Nhịp tim định kỳ mỗi 3 giây (heartbeat).",
          "operationId": "stream_earthquakes_api_v1_stream_earthquakes_get",
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {}
                }
              },
              "description": "Successful Response"
            }
          },
          "summary": "Stream Earthquakes",
          "tags": [
            "Streaming"
          ]
        }
      },
