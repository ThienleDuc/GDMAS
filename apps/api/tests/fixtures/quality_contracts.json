      "/api/v1/stream/broadcast-cleared": {
        "post": {
          "description": "Endpoint kích hoạt thông báo CSDL đã bị xóa trống (Demo Bước 2)\nngay lập tức tới toàn bộ các tab trình duyệt đang mở qua kết nối SSE.",
          "operationId": "broadcast_database_cleared_api_v1_stream_broadcast_cleared_post",
