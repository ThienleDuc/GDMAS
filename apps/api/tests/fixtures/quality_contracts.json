          },
          "summary": "Get All Patterns",
          "tags": [
            "Patterns"
          ]
        }
      },
      "/api/v1/statistics/earthquakes": {
        "get": {
          "description": "Trả về các chỉ số thống kê nhanh phục vụ các thẻ KPI và biểu đồ chuỗi thời gian trên Dashboard.",
          "operationId": "get_earthquake_statistics_api_v1_statistics_earthquakes_get",
          "responses": {
            "200": {
              "content": {
