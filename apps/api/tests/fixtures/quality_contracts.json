      "/api/v1/earthquakes": {
        "get": {
          "description": "Truy vấn danh sách các sự kiện địa chấn có hỗ trợ phân trang, lọc theo độ lớn, độ sâu và tìm kiếm.",
          "operationId": "list_earthquakes_api_v1_earthquakes_get",
          "parameters": [
            {
              "description": "Số trang hiện tại",
              "in": "query",
              "name": "page",
              "required": false,
              "schema": {
                "default": 1,
                "description": "Số trang hiện tại",
                "minimum": 1,
                "title": "Page",
                "type": "integer"
              }
            },
            {
              "description": "Số bản ghi mỗi trang",
              "in": "query",
              "name": "limit",
              "required": false,
              "schema": {
                "default": 20,
                "description": "Số bản ghi mỗi trang",
                "maximum": 100,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              }
            },
            {
              "description": "Lọc theo độ lớn tối thiểu",
              "in": "query",
              "name": "min_magnitude",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Lọc theo độ lớn tối thiểu",
                "title": "Min Magnitude"
              }
            },
            {
              "description": "Lọc theo độ lớn tối đa",
              "in": "query",
              "name": "max_magnitude",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Lọc theo độ lớn tối đa",
                "title": "Max Magnitude"
              }
            },
            {
              "description": "Lọc theo độ sâu tối thiểu (km)",
              "in": "query",
              "name": "min_depth",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Lọc theo độ sâu tối thiểu (km)",
                "title": "Min Depth"
              }
            },
            {
              "description": "Lọc theo độ sâu tối đa (km)",
              "in": "query",
              "name": "max_depth",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Lọc theo độ sâu tối đa (km)",
                "title": "Max Depth"
              }
            },
            {
              "description": "Tìm kiếm theo khu vực hoặc mã sự kiện",
              "in": "query",
              "name": "search",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Tìm kiếm theo khu vực hoặc mã sự kiện",
                "title": "Search"
              }
            },
            {
              "in": "query",
              "name": "sort_by",
              "required": false,
              "schema": {
                "default": "event_time",
                "pattern": "^(event_time|magnitude|depth_km)$",
                "title": "Sort By",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "order",
              "required": false,
              "schema": {
                "default": "desc",
                "pattern": "^(asc|desc)$",
                "title": "Order",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/EarthquakeListResponse"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          },
          "summary": "List Earthquakes",
          "tags": [
            "Earthquakes"
          ]
        }
      },
      "/api/v1/earthquakes/sync": {
        "post": {
          "description": "Kích hoạt đồng bộ hóa dữ liệu trực tiếp từ USGS GeoJSON API Feed.\nLưu vào CSDL PostgreSQL nếu khả dụng hoặc cập nhật bộ nhớ đệm thời gian thực.",
          "operationId": "sync_usgs_earthquakes_api_v1_earthquakes_sync_post",
