# ==============================================================================
# GDMAS FRONTEND CLIENT ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# API base URL used by src/lib/api-client.ts and src/hooks/useSSE.ts
VITE_API_BASE_URL=http://localhost:8000

# Optional override for the Server-Sent Events endpoint
VITE_SSE_ENDPOINT=/api/v1/stream/earthquakes

# Uncomment to serve contract fixtures from Vite's local dev server.
# The mock middleware is development-only; production builds always use the real API.
# VITE_API_MOCKING=enabled

