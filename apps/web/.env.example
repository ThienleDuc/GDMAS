# ==============================================================================
# GDMAS FRONTEND CLIENT ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# API base URL used by src/lib/api-client.ts and src/hooks/useSSE.ts
# Local (không Docker): giữ http://localhost:8000 + CORS_ORIGINS của BE.
# Docker: đặt "/" để gọi /api/... cùng origin (xem VITE_API_PROXY_TARGET bên dưới).
VITE_API_BASE_URL=http://localhost:8000

# Optional: Vite dev proxy cho /api → backend. Khi đặt, FE không gọi trực tiếp
# localhost:8000 nên không bị CORS / "Status code: (null)" trên trình duyệt.
# Trong docker-compose giá trị là http://api:8000 (service name trên gdmas-net).
# Để trống khi chạy pnpm dev trên host và BE đã chạy ở localhost:8000.
VITE_API_PROXY_TARGET=

# Optional override for the Server-Sent Events endpoint.
# Default (when unset) is /api/v1/events/stream per docs/api/API.md §3.5.
# Keep the legacy route below only if the backend has not deployed /events/stream.
VITE_SSE_ENDPOINT=/api/v1/events/stream

# Keep "disabled" to consume the real BE (required by docs/setup.md smoke test).
# Set "enabled" ONLY for local dev without a running backend — never for official views.
VITE_API_MOCKING=disabled

# Nguồn tile bản đồ (Terminal 7). Mặc định để trống → dùng /tile/{z}/{x}/{y}.png cùng origin
# (Vite dev/preview proxy hoặc nginx trong apps/web/Dockerfile chuyển tới OSM DE — không cần API key).
# Đừng dùng CARTO basemap: hiện trả ảnh "API KEY REQUIRED" dù HTTP 200.
# Chỉ đặt URL tuyệt đối khi môi trường không proxy được /tile.
VITE_MAP_TILE_URL=

# Ngưỡng độ lớn tối thiểu của bản đồ realtime — docker-compose lấy từ
# BACKFILL_MIN_MAGNITUDE trong .env backend. Không render bộ lọc trên UI.
VITE_MAP_MIN_MAGNITUDE=2.5

