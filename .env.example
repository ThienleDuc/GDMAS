# ==============================================================================
# GLOBAL DISASTER MONITORING & ANALYSIS SYSTEM (GDMAS)
# CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Thứ tự ưu tiên: shell env > .env > default trong code.
# Nếu shell đã export cùng tên (vd. ANALYSIS_WINDOW_DAYS=365), giá trị đó SẼ thắng .env.
# Kiểm tra: `env | grep WINDOW_DAYS`; dọn: `unset DATA_WINDOW_DAYS ANALYSIS_WINDOW_DAYS CLUSTERING_WINDOW_DAYS`.

# ------------------------------------------------------------------------------
# 1. DATABASE POSTGRESQL 16 (DOCKER / LOCAL)
# ------------------------------------------------------------------------------
POSTGRES_USER=gdmas_user
POSTGRES_PASSWORD=gdmas_secure_password_2026
POSTGRES_DB=gdmas_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://gdmas_user:gdmas_secure_password_2026@localhost:5432/gdmas_db

# ------------------------------------------------------------------------------
# 2. DATABASE REST API (FASTAPI)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. WORKER SERVICES SCHEDULE & USGS INGESTION
# ------------------------------------------------------------------------------
# Chu kỳ 4 worker theo docs/yeucaubatbuoc.md §1.2 (sơ đồ ASCII):
#   Data Ingestion   = 5 phút/lần  → 300
#   Data Analysis    = 5 phút/lần  → 300
#   Prediction       = 5 phút/lần  → 300
#   Clustering       = 1 ngày/lần → 86400
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
INGESTION_INTERVAL_SECONDS=300
ANALYSIS_INTERVAL_SECONDS=300
PREDICTION_INTERVAL_SECONDS=300
CLUSTERING_INTERVAL_SECONDS=86400

# --- Cấu hình dữ liệu & mô hình (docs/yeucaubatbuoc.md §6.4) ---
# Cửa sổ lịch sử: 30 ngày = 1 tháng (docker-compose.yml đọc qua ${...:-30}).
DATA_WINDOW_DAYS=30
ANALYSIS_WINDOW_DAYS=30
CLUSTERING_WINDOW_DAYS=30
# DBSCAN: bán kính eps (km) và số điểm tối thiểu.
CLUSTERING_EPS_KM=150
CLUSTERING_MIN_SAMPLES=5
# Backfill 1 năm qua FDSN (giới hạn 20000 kết quả/query → chia theo tháng).
BACKFILL_MIN_MAGNITUDE=2.5
BACKFILL_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
# Số ngày quan sát tối thiểu để dự báo t+1.
PREDICTION_MIN_OBSERVED=10


# ------------------------------------------------------------------------------
# 8. AI TRÍCH XUẤT NHẬN XÉT (CHỈ GEMINI — bổ sung 2026-11-24)
# ------------------------------------------------------------------------------
# Người dùng nhập model + key qua dialog trên aside nav. BE kiểm tra key với Gemini
# rồi ghi 2 biến này vào .env (KHÔNG lưu database). Để trống khi chưa cấu hình.
# Chỉ nhận tên mô hình dạng gemini-* (vd. gemini-2.0-flash).
GEMINI_MODEL=
GEMINI_API_KEY=
